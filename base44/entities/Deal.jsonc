{
  // SINGLE-COACH MODEL + SERVER-ENFORCED WORKFLOW.
  //
  // read   : the host who owns the deal, or staff.
  // create : the host only, ownership pinned server-side. The saveDeal backend
  //          function creates through the *user-scoped* client precisely so
  //          created_by_id lands on the real owner.
  // update : NOBODY from the browser. Gated on a role that does not exist, so
  //          every edit must go through the saveDeal backend function, which
  //          updates via asServiceRole. This is what makes the status rules
  //          unbypassable — without it a host could PATCH the entity directly
  //          and set status to "lease signed" with no permission artifact.
  // delete : the host who owns the deal, or staff.
  //
  // `coach_id` is retained for backwards compatibility. Nothing reads it.

  "name": "Deal",
  "type": "object",
  "properties": {
    "nickname": {
      "type": "string"
    },
    "beds": {
      "type": "number"
    },
    "baths": {
      "type": "number"
    },
    "monthly_rent": {
      "type": "number"
    },
    "utilities": {
      "type": "number"
    },
    "furnishing_cost": {
      "type": "number"
    },
    "deposit": {
      "type": "number"
    },
    "drive_time_minutes": {
      "type": "number"
    },
    "location_score": {
      "type": "number"
    },
    "size_score": {
      "type": "number"
    },
    "condition_score": {
      "type": "number"
    },
    "revenue_mode": {
      "type": "string",
      "enum": [
        "nightly",
        "monthly"
      ],
      "default": "nightly"
    },
    "nightly_adr": {
      "type": "number"
    },
    "monthly_str_revenue": {
      "type": "number"
    },
    "occupancy": {
      "type": "number",
      "default": 0.6
    },
    "conservatism_haircut": {
      "type": "number",
      "default": 0.15
    },
    "haircut_override_reason": {
      "type": "string"
    },
    "mtr_revenue_estimate": {
      "type": "number"
    },
    "permission_type": {
      "type": "string",
      "enum": [
        "verbal",
        "email",
        "signed",
        "none"
      ],
      "default": "none"
    },
    "permission_artifact_url": {
      "type": "string"
    },
    "gross_revenue": {
      "type": "number"
    },
    "variable_costs": {
      "type": "number"
    },
    "furniture_reserve": {
      "type": "number"
    },
    "cash_profit": {
      "type": "number"
    },
    "true_profit": {
      "type": "number"
    },
    "profit_margin_pct": {
      "type": "number"
    },
    "months_to_recoup": {
      "type": "number"
    },
    "recommended_strategy": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "evaluating"
      ]
    },
    "fail_fix": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "evaluating",
        "outreach sent",
        "negotiating",
        "lease signed",
        "passed",
        "lost"
      ],
      "default": "evaluating"
    },
    "coach_id": {
      "type": "string"
    }
  },
  "required": [
    "nickname"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "__system_never__"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    }
  }
}
