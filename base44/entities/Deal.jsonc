{
  // SINGLE-COACH MODEL.
  //
  // read/update/delete : the host who owns the record, or staff.
  // create             : the host only, with ownership pinned server-side.
  //
  // "Staff" is the one business owner, whose account may carry either the
  // `coach` or the `admin` role — they are treated identically. There is no
  // per-host coach assignment, because there is one coach.
  //
  // The former `data.coach_id` read clause was removed. It existed only to
  // route hosts to different coaches, and it was host-writable, so a host
  // could set it to an arbitrary user id and grant that stranger read access
  // to their own record. Nothing grants access by a field the host controls.
  //
  // `coach_id` is retained on the schema for backwards compatibility with
  // records already written. Nothing reads it. Candidate for removal.

  "name": "Deal",
  "type": "object",
  "properties": {
    "nickname": {
      "type": "string"
    },
    "beds": {
      "type": "number"
    },
    "baths": {
      "type": "number"
    },
    "monthly_rent": {
      "type": "number"
    },
    "utilities": {
      "type": "number"
    },
    "furnishing_cost": {
      "type": "number"
    },
    "deposit": {
      "type": "number"
    },
    "drive_time_minutes": {
      "type": "number"
    },
    "location_score": {
      "type": "number"
    },
    "size_score": {
      "type": "number"
    },
    "condition_score": {
      "type": "number"
    },
    "revenue_mode": {
      "type": "string",
      "enum": [
        "nightly",
        "monthly"
      ],
      "default": "nightly"
    },
    "nightly_adr": {
      "type": "number"
    },
    "monthly_str_revenue": {
      "type": "number"
    },
    "occupancy": {
      "type": "number",
      "default": 0.6
    },
    "conservatism_haircut": {
      "type": "number",
      "default": 0.15
    },
    "haircut_override_reason": {
      "type": "string"
    },
    "mtr_revenue_estimate": {
      "type": "number"
    },
    "permission_type": {
      "type": "string",
      "enum": [
        "verbal",
        "email",
        "signed",
        "none"
      ],
      "default": "none"
    },
    "permission_artifact_url": {
      "type": "string"
    },
    "gross_revenue": {
      "type": "number"
    },
    "variable_costs": {
      "type": "number"
    },
    "furniture_reserve": {
      "type": "number"
    },
    "cash_profit": {
      "type": "number"
    },
    "true_profit": {
      "type": "number"
    },
    "profit_margin_pct": {
      "type": "number"
    },
    "months_to_recoup": {
      "type": "number"
    },
    "recommended_strategy": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "evaluating"
      ]
    },
    "fail_fix": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "evaluating",
        "outreach sent",
        "negotiating",
        "lease signed",
        "passed",
        "lost"
      ],
      "default": "evaluating"
    },
    "coach_id": {
      "type": "string"
    }
  },
  "required": [
    "nickname"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    }
  }
}
