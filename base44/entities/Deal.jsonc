{
  "name": "Deal",
  "type": "object",
  "properties": {
    "nickname": {
      "type": "string"
    },
    "beds": {
      "type": "number"
    },
    "baths": {
      "type": "number"
    },
    "monthly_rent": {
      "type": "number"
    },
    "utilities": {
      "type": "number"
    },
    "furnishing_cost": {
      "type": "number"
    },
    "deposit": {
      "type": "number"
    },
    "drive_time_minutes": {
      "type": "number"
    },
    "location_score": {
      "type": "number"
    },
    "size_score": {
      "type": "number"
    },
    "condition_score": {
      "type": "number"
    },
    "revenue_mode": {
      "type": "string",
      "enum": [
        "nightly",
        "monthly"
      ],
      "default": "nightly"
    },
    "nightly_adr": {
      "type": "number"
    },
    "monthly_str_revenue": {
      "type": "number"
    },
    "occupancy": {
      "type": "number",
      "default": 0.6
    },
    "conservatism_haircut": {
      "type": "number",
      "default": 0.15
    },
    "haircut_override_reason": {
      "type": "string"
    },
    "mtr_revenue_estimate": {
      "type": "number"
    },
    "permission_type": {
      "type": "string",
      "enum": [
        "verbal",
        "email",
        "signed",
        "none"
      ],
      "default": "none"
    },
    "permission_artifact_url": {
      "type": "string"
    },
    "gross_revenue": {
      "type": "number"
    },
    "variable_costs": {
      "type": "number"
    },
    "furniture_reserve": {
      "type": "number"
    },
    "cash_profit": {
      "type": "number"
    },
    "true_profit": {
      "type": "number"
    },
    "profit_margin_pct": {
      "type": "number"
    },
    "months_to_recoup": {
      "type": "number"
    },
    "recommended_strategy": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "evaluating"
      ]
    },
    "fail_fix": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "evaluating",
        "outreach sent",
        "negotiating",
        "lease signed",
        "passed",
        "lost"
      ],
      "default": "evaluating"
    },
    "coach_id": {
      "type": "string"
    }
  },
  "required": [
    "nickname"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.coach_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}