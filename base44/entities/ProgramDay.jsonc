{
  "name": "ProgramDay",
  "type": "object",
  "properties": {
    "week": {
      "type": "number",
      "minimum": 1,
      "maximum": 4,
      "description": "Program week 1-4"
    },
    "day": {
      "type": "number",
      "minimum": 1,
      "maximum": 28,
      "description": "Program day 1-28"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "why_it_matters": {
      "type": "string",
      "maxLength": 2000
    },
    "gate": {
      "type": "boolean",
      "default": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "time_estimate": {
            "type": "string",
            "maxLength": 60
          },
          "completion_condition": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    }
  },
  "required": [
    "week",
    "day",
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}