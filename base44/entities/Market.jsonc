{
  // SINGLE-COACH MODEL.
  //
  // read/update/delete : the host who owns the record, or staff.
  // create             : the host only, with ownership pinned server-side.
  //
  // "Staff" is the one business owner, whose account may carry either the
  // `coach` or the `admin` role — they are treated identically. There is no
  // per-host coach assignment, because there is one coach.
  //
  // The former `data.coach_id` read clause was removed. It existed only to
  // route hosts to different coaches, and it was host-writable, so a host
  // could set it to an arbitrary user id and grant that stranger read access
  // to their own record. Nothing grants access by a field the host controls.
  //
  // `coach_id` is retained on the schema for backwards compatibility with
  // records already written. Nothing reads it. Candidate for removal.

  "name": "Market",
  "type": "object",
  "properties": {
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "submarket": {
      "type": "string"
    },
    "adr": {
      "type": "number"
    },
    "occupancy_rate": {
      "type": "number",
      "description": "0-100"
    },
    "revpar": {
      "type": "number"
    },
    "active_listings": {
      "type": "number"
    },
    "comp_count": {
      "type": "number"
    },
    "comp_revenue_low": {
      "type": "number"
    },
    "comp_revenue_median": {
      "type": "number"
    },
    "comp_revenue_high": {
      "type": "number"
    },
    "average_market_rent": {
      "type": "number"
    },
    "regulation_status": {
      "type": "string",
      "enum": [
        "permitted",
        "restricted",
        "banned",
        "pending"
      ],
      "default": "pending"
    },
    "regulation_source_url": {
      "type": "string"
    },
    "regulation_evidence_url": {
      "type": "string"
    },
    "data_pulled_date": {
      "type": "string",
      "format": "date"
    },
    "arbitrage_spread": {
      "type": "number"
    },
    "spread_ratio": {
      "type": "number"
    },
    "composite_score": {
      "type": "number"
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "go",
        "hold",
        "no_go"
      ]
    },
    "summary": {
      "type": "string"
    },
    "stale_data_flag": {
      "type": "boolean"
    },
    "thin_market_flag": {
      "type": "boolean"
    },
    "coach_id": {
      "type": "string"
    }
  },
  "required": [
    "city"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    }
  }
}
