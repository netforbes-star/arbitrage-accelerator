{
  "name": "Market",
  "type": "object",
  "properties": {
    "city": {
      "type": "string",
      "maxLength": 120
    },
    "state": {
      "type": "string",
      "maxLength": 60
    },
    "submarket": {
      "type": "string",
      "maxLength": 120
    },
    "adr": {
      "type": "number",
      "minimum": 0,
      "description": "Average daily rate in USD"
    },
    "occupancy_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "0-100"
    },
    "revpar": {
      "type": "number",
      "minimum": 0,
      "description": "Revenue per available room in USD"
    },
    "active_listings": {
      "type": "number",
      "minimum": 0
    },
    "comp_count": {
      "type": "number",
      "minimum": 0
    },
    "comp_revenue_low": {
      "type": "number",
      "minimum": 0
    },
    "comp_revenue_median": {
      "type": "number",
      "minimum": 0
    },
    "comp_revenue_high": {
      "type": "number",
      "minimum": 0
    },
    "average_market_rent": {
      "type": "number",
      "minimum": 0
    },
    "regulation_status": {
      "type": "string",
      "enum": [
        "permitted",
        "restricted",
        "banned",
        "pending"
      ],
      "default": "pending"
    },
    "regulation_source_url": {
      "type": "string",
      "pattern": "^$|^https?://.+",
      "maxLength": 2048
    },
    "regulation_evidence_url": {
      "type": "string",
      "pattern": "^$|^https?://.+",
      "maxLength": 2048
    },
    "data_pulled_date": {
      "type": "string",
      "format": "date"
    },
    "arbitrage_spread": {
      "type": "number",
      "description": "Can be negative"
    },
    "spread_ratio": {
      "type": "number",
      "minimum": 0
    },
    "composite_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "0-100 composite"
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "go",
        "hold",
        "no_go"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "stale_data_flag": {
      "type": "boolean"
    },
    "thin_market_flag": {
      "type": "boolean"
    },
    "coach_id": {
      "type": "string"
    }
  },
  "required": [
    "city"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    }
  }
}