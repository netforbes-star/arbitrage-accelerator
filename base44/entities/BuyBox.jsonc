{
  "name": "BuyBox",
  "type": "object",
  "properties": {
    "bedrooms": {
      "type": "number",
      "minimum": 0,
      "default": 2
    },
    "bathrooms": {
      "type": "number",
      "minimum": 0,
      "default": 1
    },
    "max_monthly_rent": {
      "type": "number",
      "minimum": 0
    },
    "max_drive_time_minutes": {
      "type": "number",
      "minimum": 0
    },
    "requires_fenced_yard": {
      "type": "boolean",
      "default": false
    },
    "pets_allowed": {
      "type": "boolean",
      "default": false
    },
    "parking_required": {
      "type": "boolean",
      "default": false
    },
    "furnished_allowed_required": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "coach_id": {
      "type": "string",
      "maxLength": 64
    }
  },
  "required": [
    "bedrooms",
    "bathrooms"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    }
  }
}
