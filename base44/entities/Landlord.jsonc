{
  "name": "Landlord",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "company": {
      "type": "string",
      "maxLength": 120
    },
    "type": {
      "type": "string",
      "enum": [
        "private",
        "pm"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "not contacted",
        "contacted",
        "responded",
        "conversation held",
        "property viewed",
        "negotiating",
        "won",
        "lost",
        "nurture"
      ],
      "default": "not contacted"
    },
    "email": {
      "type": "string",
      "pattern": "^$|^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
      "maxLength": 254
    },
    "phone": {
      "type": "string",
      "maxLength": 40
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "last_contact_date": {
      "type": "string",
      "format": "date"
    },
    "next_action_date": {
      "type": "string",
      "format": "date"
    },
    "coach_id": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    }
  }
}