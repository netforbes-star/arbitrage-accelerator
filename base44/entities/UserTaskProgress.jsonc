{
  "name": "UserTaskProgress",
  "type": "object",
  "properties": {
    "day": {
      "type": "number"
    },
    "task_index": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "skipped"
      ],
      "default": "pending"
    },
    "skipped_reason": {
      "type": "string"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "coach_id": {
      "type": "string"
    }
  },
  "required": [
    "day",
    "task_index"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.coach_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}