{
  // SINGLE-COACH MODEL.
  //
  // read/update/delete : the host who owns the record, or staff.
  // create             : the host only, with ownership pinned server-side.
  //
  // "Staff" is the one business owner, whose account may carry either the
  // `coach` or the `admin` role — they are treated identically. There is no
  // per-host coach assignment, because there is one coach.
  //
  // The former `data.coach_id` read clause was removed. It existed only to
  // route hosts to different coaches, and it was host-writable, so a host
  // could set it to an arbitrary user id and grant that stranger read access
  // to their own record. Nothing grants access by a field the host controls.
  //
  // `coach_id` is retained on the schema for backwards compatibility with
  // records already written. Nothing reads it. Candidate for removal.

  "name": "OnboardingProfile",
  "type": "object",
  "properties": {
    "portfolio_size": {
      "type": "string",
      "description": "Current number of properties in the host's portfolio"
    },
    "target_market_city": {
      "type": "string"
    },
    "capital_available": {
      "type": "number",
      "description": "Capital available in USD"
    },
    "hours_per_week": {
      "type": "number"
    },
    "biggest_constraint": {
      "type": "string"
    },
    "goal_28_day": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "weekly_outreach_target": {
      "type": "number",
      "default": 20
    },
    "coach_id": {
      "type": "string",
      "description": "Assigned coach user id"
    },
    "terms_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "terms_version": {
      "type": "string"
    },
    "acknowledgements_accepted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "target_market_city",
    "start_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    }
  }
}
