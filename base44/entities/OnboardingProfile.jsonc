{
  "name": "OnboardingProfile",
  "type": "object",
  "properties": {
    "portfolio_size": {
      "type": "string",
      "description": "Current number of properties in the host's portfolio",
      "maxLength": 100
    },
    "target_market_city": {
      "type": "string",
      "maxLength": 120
    },
    "capital_available": {
      "type": "number",
      "minimum": 0,
      "description": "Capital available in USD"
    },
    "hours_per_week": {
      "type": "number",
      "minimum": 0,
      "description": "Hours committed per week; negative values are not valid"
    },
    "biggest_constraint": {
      "type": "string",
      "enum": [
        "Time",
        "Capital",
        "Market knowledge",
        "Landlord access",
        "Confidence"
      ]
    },
    "goal_28_day": {
      "type": "string",
      "maxLength": 500
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "weekly_outreach_target": {
      "type": "number",
      "minimum": 0,
      "default": 20
    },
    "coach_id": {
      "type": "string",
      "description": "Assigned coach user id",
      "maxLength": 64
    },
    "terms_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "terms_version": {
      "type": "string",
      "maxLength": 40
    },
    "acknowledgements_accepted": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80
      }
    }
  },
  "required": [
    "target_market_city",
    "start_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    }
  }
}
