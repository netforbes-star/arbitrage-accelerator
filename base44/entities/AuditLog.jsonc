{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "actor_email": {
      "type": "string",
      "maxLength": 254
    },
    "actor_role": {
      "type": "string",
      "maxLength": 60
    },
    "action": {
      "type": "string",
      "maxLength": 200
    },
    "target_user_email": {
      "type": "string",
      "maxLength": 320
    },
    "target_type": {
      "type": "string",
      "maxLength": 100
    },
    "target_id": {
      "type": "string",
      "maxLength": 200
    },
    "details": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "action"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "__system_never__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__system_never__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__system_never__"
      }
    }
  }
}