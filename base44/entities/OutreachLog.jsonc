{
  "name": "OutreachLog",
  "type": "object",
  "properties": {
    "landlord_id": {
      "type": "string"
    },
    "landlord_name": {
      "type": "string",
      "maxLength": 120
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "phone",
        "text",
        "in-person",
        "direct mail",
        "social"
      ]
    },
    "template": {
      "type": "string",
      "maxLength": 200
    },
    "outcome": {
      "type": "string",
      "maxLength": 2000
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "coach_id": {
      "type": "string",
      "maxLength": 64
    }
  },
  "required": [
    "landlord_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    }
  }
}
