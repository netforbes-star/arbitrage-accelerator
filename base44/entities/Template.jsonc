{
  "name": "Template",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Markdown content with {{variables}}"
    },
    "variables": {
      "type": "string",
      "description": "Comma-separated variable hints"
    }
  },
  "required": [
    "title",
    "category",
    "content"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}