{
  "name": "Sign-In Audit",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "app_user_auth",
      "events": [
        "login",
        "signup"
      ]
    }
  },
  "description": "Records every sign-in and sign-up in the append-only audit log",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sign_in_audit",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "write_audit": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logSignIn",
            "args": {
              "user_id": "${ .trigger.user_id }",
              "email": "${ .trigger.email }",
              "auth_method": "${ .trigger.auth_method }",
              "activity": "${ .trigger.event_type }",
              "role": "${ .trigger.role }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Write audit entry",
            "description": "Logs the sign-in"
          }
        }
      }
    ]
  }
}